@@ -12,6 +12,56 @@ use store::{
 };
 use utils::codec::base32_custom::{Base32Reader, Base32Writer};
 
+/// An imported verifier hashes the whole client password, unlike native app passwords.
+/// Keep this marker in the existing secret field to avoid changing the registry format.
+pub const LEGACY_APP_PASSWORD_PREFIX: &str = "{LEGACY-BCRYPT}";
+
+pub fn legacy_app_password_hash(secret: &str) -> Option<&str> {
+    let hash = secret.strip_prefix(LEGACY_APP_PASSWORD_PREFIX)?;
+    let bytes = hash.as_bytes();
+    if bytes.len() == 60
+        && matches!(bytes.get(..4), Some(b"$2a$" | b"$2b$" | b"$2y$"))
+        && bytes[4..6].iter().all(u8::is_ascii_digit)
+        && (4..=31).contains(&hash[4..6].parse::<u8>().ok()?)
+        && bytes[6] == b'$'
+        && bytes[7..]
+            .iter()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'/'))
+    {
+        Some(hash)
+    } else {
+        None
+    }
+}
+
+/// Select only explicitly imported app passwords, never API keys or primary passwords.
+pub async fn legacy_app_password_id(
+    account: &registry::schema::structs::UserAccount,
+    secret: &str,
+    now: u64,
+) -> trc::Result<Option<u32>> {
+    if secret.is_empty() || secret.contains('\0') {
+        return Ok(None);
+    }
+    let mut candidates = Vec::new();
+    for credential in account.credentials.iter() {
+        if let registry::schema::structs::Credential::AppPassword(credential) = credential
+            && !credential
+                .expires_at
+                .is_some_and(|expiry| expiry.timestamp() <= now as i64)
+            && let Some(hash) = legacy_app_password_hash(&credential.secret)
+        {
+            candidates.push((credential.credential_id.document_id(), hash.to_string()));
+        }
+    }
+    if candidates.is_empty() {
+        Ok(None)
+    } else {
+        directory::core::secret::verify_bcrypt_candidates(candidates, secret.as_bytes().to_vec())
+            .await
+    }
+}
