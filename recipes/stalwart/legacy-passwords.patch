@@ -0,0 +1,95 @@
+"""Synthetic input and boundary tests for the disposable importer."""
+import copy
+import json
+from pathlib import Path
+import sqlite3
+import tempfile
+import unittest
+from legacy_password_import import Client, ImportFailure, load_source, normalize_hash, prepare
+
+HASH = "$2y$04$" + "A" * 53
+
+
+def fixture():
+    return {"domain": [{"domain": "example.org", "active": 1}],
+            "mailbox": [{"username": "shared@example.org", "active": 1,
+                         "has_tfa": "0", "password": "{BLF-CRYPT}" + HASH}],
+            "app": [{"id": 7, "mailbox": "shared@example.org", "active": 1,
+                     "name": "Thunderbird", "password": "{BLF-CRYPT}" + HASH}]}
+
+
+class ImporterTests(unittest.TestCase):
+    def test_primary_hash_is_preserved_and_app_hash_is_marked(self):
+        entry = prepare(fixture(), {"shared@example.org": "abc"})[0]
+        self.assertEqual(entry["primary"], HASH)
+        self.assertEqual(entry["apps"][0]["secret"], "{LEGACY-BCRYPT}" + HASH)
+        self.assertEqual(entry["apps"][0]["permissions"], {"@type": "Inherit"})
+
+    def test_revoked_credentials_are_not_imported(self):
+        source = fixture()
+        source["app"][0]["active"] = 0
+        self.assertEqual(prepare(source, {"shared@example.org": "abc"})[0]["apps"], [])
+
+    def test_only_explicitly_mapped_mailboxes_are_selected(self):
+        source = fixture()
+        source["app"].append({"id": 9, "mailbox": "other@example.org", "active": 1,
+                              "password": "invalid-unselected-value"})
+        self.assertEqual(len(prepare(source, {"shared@example.org": "abc"})[0]["apps"]), 1)
+
+    def test_inactive_mailbox_and_domain_are_rejected(self):
+        for kind in ("mailbox", "domain"):
+            source = fixture()
+            source[kind][0]["active"] = 0
+            with self.assertRaises(ImportFailure):
+                prepare(source, {"shared@example.org": "abc"})
+
+    def test_mfa_is_not_silently_dropped(self):
+        source = fixture()
+        source["mailbox"][0]["has_tfa"] = "1"
+        with self.assertRaises(ImportFailure):
+            prepare(source, {"shared@example.org": "abc"})
+
+    def test_malformed_verifier_and_plaintext_are_rejected(self):
+        for value in ("plaintext", "$2y$03$" + "A" * 53, "$2y$99$" + "A" * 53,
+                      "{LEGACY-BCRYPT}" + HASH, HASH + "extra"):
+            with self.assertRaises(ImportFailure):
+                normalize_hash(value)
+
+    def test_duplicate_source_ids_are_rejected(self):
+        source = fixture()
+        source["app"].append(copy.deepcopy(source["app"][0]))
+        with self.assertRaises(ImportFailure):
+            prepare(source, {"shared@example.org": "abc"})
+
+    def test_external_or_ambiguous_endpoints_are_rejected(self):
+        for url in ("https://mail.example.org/jmap/", "http://localhost:8080/jmap/",
+                    "http://127.0.0.1.example.org/jmap/", "http://user:secret@127.0.0.1/jmap/"):
+            with self.assertRaises(ImportFailure):
+                Client(url, {"username": "synthetic", "password": "synthetic"})
+
+    def test_sqlite_source_is_read_only(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "credentials.sqlite"
+            with sqlite3.connect(path) as db:
+                db.execute("CREATE TABLE objects(kind TEXT,id TEXT,data TEXT)")
+                for kind, rows in fixture().items():
+                    for row in rows:
+                        db.execute("INSERT INTO objects VALUES(?,?,?)", (kind, "1", json.dumps(row)))
+            before = path.read_bytes()
+            loaded = load_source(path, sqlite=True)
+            self.assertEqual(loaded, fixture())
+            self.assertEqual(path.read_bytes(), before)
+
+    def test_portable_secret_input_must_be_private(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "source.json"
+            path.write_text(json.dumps(fixture()))
+            path.chmod(0o644)
+            with self.assertRaises(ImportFailure):
+                load_source(path)
+            path.chmod(0o600)
+            self.assertEqual(load_source(path), fixture())
+
+
+if __name__ == "__main__":
+    unittest.main()
