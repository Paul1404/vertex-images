+/// Try a bounded, account-local list of imported bcrypt verifiers off the
+/// async worker. A login with several saved credentials must not stall I/O.
+pub async fn verify_bcrypt_candidates(
+    candidates: Vec<(u32, String)>,
+    secret: Vec<u8>,
+) -> trc::Result<Option<u32>> {
+    tokio::task::spawn_blocking(move || {
+        candidates
+            .into_iter()
+            .find_map(|(id, hash)| bcrypt::verify(&secret, &hash).then_some(id))
+    })
+    .await
+    .map_err(|err| {
+        trc::EventType::Server(trc::ServerEvent::ThreadError)
+            .caused_by(trc::location!())
+            .reason(err)
+    })
+}
