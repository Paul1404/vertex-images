+pub trait AssertConfig {
+    fn assert_no_errors(self) -> Self;
+    fn assert_no_warnings(self) -> Self;
+}
+impl AssertConfig for Bootstrap {
+    fn assert_no_errors(self) -> Self {
+        assert!(self.errors.is_empty(), "{:?}", self.errors);
+        self
+    }
+    fn assert_no_warnings(self) -> Self {
+        assert!(self.warnings.is_empty(), "{:?}", self.warnings);
