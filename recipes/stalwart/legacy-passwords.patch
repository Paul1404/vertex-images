+        json!({
+        "domain":[{"domain":"example.org","active":1}],
+        "mailbox":[{"username":"shared@example.org","active":1,"has_tfa":"0","password":format!("{{BLF-CRYPT}}{hash}")}],
+        "app":[
+            {"id":1,"mailbox":"shared@example.org","active":1,"name":"Thunderbird","password":format!("{{BLF-CRYPT}}{client_hash}")},
+            {"id":2,"mailbox":"shared@example.org","active":1,"name":"Phone","password":format!("{{BLF-CRYPT}}{collision_hash}")},
+            {"id":3,"mailbox":"shared@example.org","active":0,"name":"Revoked","password":format!("{{BLF-CRYPT}}{client_hash}")}
+        ]}),
+    );
+    private_json(
+        &test.temp_dir.path.join("mapping.json"),
+        json!({"shared@example.org": shared_id.to_string()}),
+    );
+    private_json(
+        &test.temp_dir.path.join("auth.json"),
+        json!({
+        "username":"admin@example.org","password":"these_pretzels_are_making_me_thirsty"}),
+    );
+    assert_eq!(importer(&test, false).await["additional_credentials"], 2);
+    assert!(
+        login(
+            &test,
+            "shared@example.org",
+            "Existing Thunderbird password!"
+        )
+        .await
+        .is_err()
+    );
+    assert_eq!(importer(&test, true).await["additional_credentials"], 2);
+    assert_eq!(importer(&test, true).await["additional_credentials"], 0);
+    let shared = utils::account::Account::new(
+        "shared@example.org",
+        "Existing mailbox password!",
+        &[],
+        "Shared mailbox",
+        shared_id,
+    );
+    assert!(
+        login(&test, "shared@example.org", "Synthetic initial password!")
+            .await
+            .is_err()
+    );
+    let primary_id = login(&test, "shared@example.org", "Existing mailbox password!")
+        .await
+        .unwrap()
+        .credential_id();
+    let token = login(
+        &test,
+        "shared@example.org",
+        "Existing Thunderbird password!",
+    )
+    .await
+    .unwrap();
+    let imported_id = token.credential_id().unwrap();
+    assert_ne!(Some(imported_id), primary_id);
+    assert!(token.has_permission(Permission::ImapAuthenticate));
+    assert!(token.has_permission(Permission::EmailSend));
+    assert!(!token.has_permission(Permission::SysAccountUpdate));
+    assert!(
+        login(&test, "shared@example.org", &collision)
+            .await
+            .unwrap()
+            .credential_id()
+            .is_some()
+    );
+    assert!(
+        login(&test, "shared@example.org", "wrong password")
+            .await
+            .is_err()
+    );
+    assert!(
+        login(&test, "admin@example.org", "Existing Thunderbird password!")
+            .await
+            .is_err()
+    );
+    assert!(
+        login(
+            &test,
+            "shared@example.org%admin@example.org",
+            "Existing Thunderbird password!"
+        )
+        .await
+        .is_err()
+    );
+
+    // A primary password may also look like a native app password.
+    let primary_collision = AppPassword::new(900).build();
+    admin
+        .registry_update_object(
+            ObjectType::Account,
+            shared_id,
+            json!({
+                "credentials/0/secret": bcrypt(&primary_collision).await
+            }),
+        )
+        .await;
+    assert!(
+        login(&test, "shared@example.org", &primary_collision)
+            .await
+            .is_ok()
+    );
+    admin
+        .registry_update_object(
+            ObjectType::Account,
+            shared_id,
+            json!({
+                "credentials/0/secret": hash
+            }),
+        )
+        .await;
+
+    // Newly generated app passwords still use the original native path.
+    let native = shared
+        .registry_create([structs::AppPassword {
+            description: "New native client".into(),
+            ..Default::default()
+        }])
+        .await;
+    let native_secret = native.created(0).text_field("secret").to_string();
+    assert!(
+        login(&test, "shared@example.org", &native_secret)
+            .await
+            .is_ok()
+    );
+    // A fabricated native token must never treat an imported hash as a native hash.
+    assert!(
+        login(
+            &test,
+            "shared@example.org",
+            &AppPassword::new(imported_id).build()
+        )
+        .await
+        .is_err()
+    );
+
+    protocols(&test, "Existing mailbox password!", true).await;
+    protocols(&test, "Existing Thunderbird password!", true).await;
+    protocols(&test, &native_secret, true).await;
+
+    // Normal users cannot use the administrative import route even while enabled.
+    let forbidden = shared
+        .registry_update(
+            ObjectType::Account,
+            [(
+                shared_id,
+                json!({
+                    "credentials/40":{"@type":"AppPassword","description":"Forbidden user import",
+                        "secret":format!("{LEGACY_APP_PASSWORD_PREFIX}{client_hash}")}
+                }),
+            )],
+        )
+        .await;
+    assert_eq!(forbidden.error_type_at(0), Some("forbidden"));
+    for invalid in [
+        "plaintext-not-a-verifier".to_string(),
+        format!("{LEGACY_APP_PASSWORD_PREFIX}broken"),
+    ] {
+        admin.registry_update_object_expect_err(ObjectType::Account, shared_id, json!({
+            "credentials/40":{"@type":"AppPassword","description":"Invalid import","secret":invalid}
+        })).await;
+    }
+
+    // Imported credentials still honor native IP restrictions and expiry.
+    shared
+        .registry_update_object(
+            ObjectType::AppPassword,
+            Id::from(imported_id),
+            json!({
+                "allowedIps":{"192.0.2.1":true}
+            }),
+        )
+        .await;
+    assert!(
+        login(
+            &test,
+            "shared@example.org",
+            "Existing Thunderbird password!"
+        )
+        .await
+        .is_err()
+    );
+    shared
+        .registry_update_object(
+            ObjectType::AppPassword,
+            Id::from(imported_id),
+            json!({
+                "allowedIps":{}, "expiresAt":UTCDateTime::from_timestamp(now() as i64 - 1)
+            }),
+        )
+        .await;
+    assert!(
+        login(
+            &test,
+            "shared@example.org",
+            "Existing Thunderbird password!"
+        )
+        .await
+        .is_err()
+    );
+    shared
+        .registry_update_object(
+            ObjectType::AppPassword,
+            Id::from(imported_id),
+            json!({
+                "expiresAt":null
+            }),
+        )
+        .await;
+    assert!(
+        login(
+            &test,
+            "shared@example.org",
+            "Existing Thunderbird password!"
+        )
+        .await
+        .is_ok()
+    );
+    // Primary account permissions apply equally to all imported credentials.
+    admin
+        .registry_update_object(
+            ObjectType::Account,
+            shared_id,
+            json!({
+                "permissions":{"@type":"Merge","disabledPermissions":{"authenticate":true}}
+            }),
+        )
+        .await;
+    assert!(
+        login(
+            &test,
+            "shared@example.org",
+            "Existing Thunderbird password!"
+        )
+        .await
+        .is_err()
+    );
+    admin
+        .registry_update_object(
+            ObjectType::Account,
+            shared_id,
+            json!({
+                "permissions":{"@type":"Inherit"}
+            }),
+        )
+        .await;
+    assert!(
+        login(
+            &test,
+            "shared@example.org",
+            "Existing Thunderbird password!"
+        )
+        .await
+        .is_ok()
+    );
+
+    // Native individual revocation invalidates the imported credential.
+    shared
+        .registry_destroy(ObjectType::AppPassword, [Id::from(imported_id)])
+        .await
+        .destroyed_ids()
+        .next()
+        .unwrap();
+    assert!(
+        login(
+            &test,
+            "shared@example.org",
+            "Existing Thunderbird password!"
+        )
+        .await
+        .is_err()
+    );
+    assert!(login(&test, "shared@example.org", &collision).await.is_ok());
+    assert!(
+        login(&test, "shared@example.org", &native_secret)
+            .await
+            .is_ok()
+    );
+    assert!(
+        login(&test, "shared@example.org", "Existing mailbox password!")
+            .await
+            .is_ok()
+    );
+    protocols(&test, "Existing Thunderbird password!", false).await;
+    protocols(&test, &collision, true).await;
+    let _ = domain_id;
+    test.shutdown();
+}
