+}
+
+async fn bcrypt(password: &str) -> String {
+    let hash = hash_secret(PasswordHashAlgorithm::Bcrypt, password.as_bytes().to_vec())
+        .await
+        .unwrap();
+    // Exercise Mailcow's actual $2y$ variant, not just the library's default.
+    format!("$2y${}", &hash[4..])
+}
