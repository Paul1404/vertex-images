+"""Authentication only against synthetic loopback listeners. Never sends mail."""
+import base64
+import imaplib
+import json
+import smtplib
+import socket
+import ssl
+import sys
+from pathlib import Path
+
+
+def check(data):
+    context = ssl._create_unverified_context()  # Synthetic certificate only.
+    username, password, expected = data["username"], data["password"], data["valid"]
+    with imaplib.IMAP4_SSL("127.0.0.1", 18893, ssl_context=context, timeout=10) as client:
+        try:
+            actual = client.login(username, password)[0] == "OK"
+        except imaplib.IMAP4.error:
+            actual = False
+        assert actual == expected, "IMAP authentication mismatch"
+    with smtplib.SMTP("127.0.0.1", 18887, timeout=10) as client:
+        client.ehlo("localhost")
+        client.starttls(context=context)
+        client.ehlo("localhost")
+        try:
+            actual = client.login(username, password)[0] == 235
+        except smtplib.SMTPAuthenticationError:
+            actual = False
+        assert actual == expected, "SMTP authentication mismatch"
+    with socket.create_connection(("127.0.0.1", 18890), timeout=10) as stream:
+        with context.wrap_socket(stream, server_hostname="localhost") as tls:
+            reader = tls.makefile("rb")
+
+            def response():
+                for _ in range(50):
+                    line = reader.readline(8192)
+                    if not line:
+                        raise AssertionError("Sieve connection closed")
+                    if line.startswith((b"OK", b"NO", b"BYE")):
+                        return line.startswith(b"OK")
+                raise AssertionError("Invalid Sieve response")
+
+            assert response(), "Sieve greeting failed"
+            value = base64.b64encode(f"\0{username}\0{password}".encode()).decode()
+            tls.sendall(f'AUTHENTICATE "PLAIN" "{value}"\r\n'.encode())
+            assert response() == expected, "Sieve authentication mismatch"
+            tls.sendall(b"LOGOUT\r\n")
+            response()
+
+
+if __name__ == "__main__":
+    try:
+        check(json.loads(Path(sys.argv[1]).read_text()))
+        print("IMAP, SMTP and Sieve authentication checks passed")
+    except Exception:
+        print("Synthetic protocol check failed", file=sys.stderr)
+        raise
