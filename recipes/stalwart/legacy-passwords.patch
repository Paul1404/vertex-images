+async fn importer(test: &TestServer, apply: bool) -> serde_json::Value {
+    let script = Path::new(env!("CARGO_MANIFEST_DIR")).join("../tools/legacy_password_import.py");
+    let mut command = tokio::process::Command::new("python3");
+    command
+        .arg(script)
+        .arg("--source-json")
+        .arg(test.temp_dir.path.join("source.json"))
+        .arg("--mapping")
+        .arg(test.temp_dir.path.join("mapping.json"))
+        .arg("--auth-file")
+        .arg(test.temp_dir.path.join("auth.json"))
+        .arg("--url")
+        .arg("https://127.0.0.1:8899/jmap/")
+        .arg("--insecure-local-tls");
+    if apply {
+        command.arg("--apply");
+    }
+    let output = command.output().await.unwrap();
+    assert!(
+        output.status.success(),
+        "Synthetic importer failed: {}",
