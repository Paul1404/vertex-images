+#[tokio::test]
+async fn imported_hash_verification_without_import_mode() {
+    // This helper and the login branch do not depend on the temporary import gate.
+    let hash = bcrypt("synthetic existing client password").await;
+    let marked = format!("{LEGACY_APP_PASSWORD_PREFIX}{hash}");
+    assert_eq!(legacy_app_password_hash(&marked), Some(hash.as_str()));
+    assert!(legacy_app_password_hash(&hash).is_none());
+    assert!(legacy_app_password_hash("{LEGACY-BCRYPT}not-a-hash").is_none());
+    let mut account = UserAccount {
+        credentials: List::from_iter([Credential::AppPassword(SecondaryCredential {
+            credential_id: Id::from(17u32),
+            secret: marked,
+            description: "Synthetic client".into(),
+            ..Default::default()
+        })]),
+        ..Default::default()
+    };
+    assert_eq!(
+        legacy_app_password_id(&account, "synthetic existing client password", now())
+            .await
+            .unwrap(),
+        Some(17)
+    );
+    for password in ["wrong", "", "bad\0input"] {
+        assert_eq!(
+            legacy_app_password_id(&account, password, now())
+                .await
+                .unwrap(),
+            None
+        );
+    }
+    if let Credential::AppPassword(credential) = account.credentials.values_mut().next().unwrap() {
+        credential.expires_at = Some(UTCDateTime::from_timestamp(now() as i64));
+    }
+    assert_eq!(
+        legacy_app_password_id(&account, "synthetic existing client password", now())
+            .await
+            .unwrap(),
+        None
+    );
+    let last_hash = bcrypt("synthetic last client password").await;
+    let mut many = UserAccount::default();
+    for id in 1u32..=12 {
+        many.credentials
+            .push(Credential::AppPassword(SecondaryCredential {
+                credential_id: Id::from(id),
+                description: format!("Synthetic client {id}"),
+                secret: format!(
+                    "{LEGACY_APP_PASSWORD_PREFIX}{}",
+                    if id == 12 { &last_hash } else { &hash }
+                ),
+                ..Default::default()
+            }));
+    }
+    let started = std::time::Instant::now();
+    let (matched, timer_elapsed) = tokio::join!(
+        legacy_app_password_id(&many, "synthetic last client password", now()),
+        async {
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+            started.elapsed()
+        }
+    );
+    assert_eq!(matched.unwrap(), Some(12));
+    assert!(
+        timer_elapsed < std::time::Duration::from_millis(500),
+        "Bcrypt blocked the async worker"
+    );
+    println!(
+        "Synthetic 12-credential last-match lookup: {} ms (debug build)",
+        started.elapsed().as_millis()
+    );
+}
