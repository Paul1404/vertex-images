index 0000000..3a088db
--- /dev/null
+++ b/tools/legacy_password_import.py
@@ -0,0 +1,213 @@
+#!/usr/bin/env python3
+"""One-off legacy credential import. Defaults to a loopback-only dry run.
+
+Input is a frozen compatibility SQLite database (opened read-only), plus an
+explicit {mailbox: native_account_id} mapping. Real credentials must stay on
+their owning server. The JSON alternative is for portable/synthetic fixtures.
+Never logs requests, responses, credentials or exception contents.
+"""
+import argparse
+import base64
+import hashlib
+import ipaddress
+import json
+import os
+from pathlib import Path
+import re
+import sqlite3
+import ssl
+import sys
+import urllib.error
+import urllib.parse
+import urllib.request
+
+PREFIX = "{LEGACY-BCRYPT}"
+BCRYPT = re.compile(r"\$2[aby]\$(0[4-9]|[12][0-9]|3[01])\$[./A-Za-z0-9]{53}")
+
+
+class ImportFailure(Exception):
+    """Contains a fixed, secret-free diagnostic only."""
+
+
+def private_json(path):
+    path = Path(path)
+    if path.stat().st_mode & 0o077:
+        raise ImportFailure("Secret input files must have mode 0600 or stricter")
+    return json.loads(path.read_text())
+
+
+def normalize_hash(value):
+    value = value.removeprefix("{BLF-CRYPT}")
+    if not BCRYPT.fullmatch(value):
+        raise ImportFailure("Unsupported or malformed password verifier")
+    return value
+
+
+def load_source(path, sqlite=False):
+    if not sqlite:
+        return private_json(path)
+    result = {"mailbox": [], "app": [], "domain": []}
+    uri = Path(path).resolve().as_uri() + "?mode=ro"
+    with sqlite3.connect(uri, uri=True) as db:
+        for kind, data in db.execute("SELECT kind,data FROM objects"):
+            if kind in result:
+                result[kind].append(json.loads(data))
+    return result
+
+
+def prepare(source, mapping):
+    if not mapping or len(set(mapping.values())) != len(mapping):
+        raise ImportFailure("Mapping must contain distinct target account IDs")
+    users = {row["username"]: row for row in source["mailbox"]}
+    domains = {row["domain"]: row for row in source["domain"]}
+    result = []
+    for mailbox, target_id in mapping.items():
+        user = users.get(mailbox)
+        domain = domains.get(mailbox.rsplit("@", 1)[-1])
+        if (not user or not domain or int(user["active"]) != 1
+                or int(domain["active"]) != 1
+                or re.search("location|thing|group", user.get("kind", ""))):
+            raise ImportFailure("Mapping contains a missing or inactive source mailbox/domain")
+        if int(user.get("has_tfa", 0)):
+            raise ImportFailure("Source primary MFA needs a separate transition")
+        apps = []
+        seen = set()
+        for app in source["app"]:
+            if app["mailbox"] != mailbox or int(app["active"]) != 1:
+                continue
+            source_id = str(app["id"])
+            if not source_id.isdecimal() or source_id in seen:
+                raise ImportFailure("Invalid or duplicate source credential ID")
+            seen.add(source_id)
+            raw = normalize_hash(app["password"])
+            # A stable source ID and verifier fingerprint allow safe retry after
+            # an uncertain HTTP outcome, without exporting the verifier on GET.
+            fingerprint = hashlib.sha256(raw.encode()).hexdigest()
+            description = f'{app.get("name") or "Mail client"} [legacy:{source_id}:{fingerprint}]'
+            apps.append({"@type": "AppPassword", "description": description,
+                         "secret": PREFIX + raw, "permissions": {"@type": "Inherit"}})
+        result.append({"mailbox": mailbox, "target_id": str(target_id),
+                       "primary": normalize_hash(user["password"]), "apps": apps})
+    return result
+
+
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args, **kwargs):
+        raise ImportFailure("Redirect refused")
+
+
+class Client:
+    def __init__(self, url, auth, insecure=False):
+        parsed = urllib.parse.urlsplit(url)
+        try:
+            loopback = ipaddress.ip_address(parsed.hostname).is_loopback
+        except ValueError:
+            loopback = False
+        if (not loopback or parsed.scheme not in ("http", "https")
+                or parsed.username or parsed.password or parsed.query or parsed.fragment):
+            raise ImportFailure("Importer accepts only explicit loopback HTTP(S) endpoints")
+        if insecure and parsed.scheme != "https":
+            raise ImportFailure("Insecure TLS option requires HTTPS")
+        self.url = url
+        self.authorization = "Basic " + base64.b64encode(
+            (auth["username"] + ":" + auth["password"]).encode()).decode()
+        context = ssl._create_unverified_context() if insecure else ssl.create_default_context()
+        self.opener = urllib.request.build_opener(
+            urllib.request.ProxyHandler({}), NoRedirect(), urllib.request.HTTPSHandler(context=context))
+
+    def call(self, method, args):
+        body = json.dumps({"using": ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"],
+                           "methodCalls": [[method, args, "import"]]}).encode()
+        request = urllib.request.Request(self.url, body, {
+            "Content-Type": "application/json", "Authorization": self.authorization})
+        try:
+            with self.opener.open(request, timeout=30) as response:
+                data = json.load(response)
+            name, result, call_id = data["methodResponses"][0]
+            if name != method or call_id != "import" or any(
+                    result.get(key) for key in ("notCreated", "notUpdated", "notDestroyed", "notFound")):
+                raise ImportFailure("Stalwart rejected the operation; no response content was logged")
+            return result
+        except ImportFailure:
+            raise
+        except Exception:
+            raise ImportFailure("JMAP request failed; reconcile with a dry run before retrying") from None
+
+
+def reconcile(client, entry, apply=False):
+    account = client.call("x:Account/get", {"ids": [entry["target_id"]],
+        "properties": ["id", "name", "domainId", "credentials", "@type"]})["list"][0]
+    domain = client.call("x:Domain/get", {"ids": [account["domainId"]],
+        "properties": ["id", "name", "isEnabled", "directoryId"]})["list"][0]
+    if (account.get("@type") != "User" or not domain["isEnabled"] or domain.get("directoryId")
+            or account["name"] + "@" + domain["name"] != entry["mailbox"]):
+        raise ImportFailure("Target identity/domain does not match the explicit source mapping")
+    credentials = account["credentials"]
+    primaries = [key for key, value in credentials.items() if value["@type"] == "Password"]
+    if len(primaries) != 1:
+        raise ImportFailure("Target must already have exactly one primary credential")
+    descriptions = [value.get("description", "") for value in credentials.values()]
+    patch = {f"credentials/{primaries[0]}/secret": entry["primary"]}
+    next_key = max(map(int, credentials), default=-1) + 1
+    additions = []
+    for app in entry["apps"]:
+        if descriptions.count(app["description"]) > 1:
+            raise ImportFailure("Duplicate imported credential provenance on target")
+        source_tag = app["description"].rsplit(" [legacy:", 1)[1].split(":", 1)[0]
+        prefix = f" [legacy:{source_tag}:"
+        if app["description"] in descriptions:
+            continue
+        if any(prefix in description for description in descriptions):
+            raise ImportFailure("Previously imported source credential changed; refusing to duplicate it")
+        patch[f"credentials/{next_key}"] = app
+        additions.append(app)
+        next_key += 1
+    if apply:
+        client.call("x:Account/set", {"update": {entry["target_id"]: patch}})
+        after = client.call("x:Account/get", {"ids": [entry["target_id"]],
+            "properties": ["id", "credentials"]})["list"][0]["credentials"]
+        for key, original in credentials.items():
+            if key not in after or after[key].get("credentialId") != original.get("credentialId"):
+                raise ImportFailure("Existing credential identity changed during readback")
+        if len(after) != len(credentials) + len(additions):
+            raise ImportFailure("Credential count readback failed")
+        for app in entry["apps"]:
+            matches = [c for c in after.values() if c.get("description") == app["description"]]
+            if len(matches) != 1 or matches[0].get("permissions", {}).get("@type") != "Inherit":
+                raise ImportFailure("Imported credential readback failed")
+    return len(additions)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    source = parser.add_mutually_exclusive_group(required=True)
+    source.add_argument("--source-db")
+    source.add_argument("--source-json", help="Synthetic/portable compatibility snapshot")
+    parser.add_argument("--mapping", required=True)
+    parser.add_argument("--auth-file", required=True)
+    parser.add_argument("--url", default="http://127.0.0.1:8080/jmap/")
+    parser.add_argument("--apply", action="store_true", help="Default is read-only dry run")
+    parser.add_argument("--insecure-local-tls", action="store_true", help="Synthetic local tests only")
+    args = parser.parse_args(argv)
+    try:
+        entries = prepare(load_source(args.source_db or args.source_json, bool(args.source_db)),
+                          json.loads(Path(args.mapping).read_text()))
+        client = Client(args.url, private_json(args.auth_file), args.insecure_local_tls)
+        # Validate every mapping before the first mutation. Account updates are
+        # individually atomic; rerunning the same frozen snapshot is idempotent.
+        additions = sum(reconcile(client, entry) for entry in entries)
+        if args.apply:
+            for entry in entries:
+                reconcile(client, entry, True)
+        print(json.dumps({"mode": "applied" if args.apply else "dry-run",
+                          "accounts": len(entries), "additional_credentials": additions}))
+        return 0
+    except ImportFailure as error:
+        print(str(error), file=sys.stderr)
+    except Exception:
+        print("Import failed; sensitive input and response details withheld", file=sys.stderr)
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
